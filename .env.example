# =====================================================================
# Nails by An — environment variables. Copy to `.env.local` (frontend +
# scripts) and set the edge-function secrets with `supabase secrets set`.
# Never commit real values.
# =====================================================================

# ---- Frontend (Vite, safe to expose: the anon key is protected by RLS) ----
# Leave VITE_SUPABASE_URL empty to run the site in DEMO mode (in-browser DB).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_BUSINESS_SLUG=nails-by-an
# Force demo mode even when a Supabase URL is set (true/false)
VITE_DEMO_MODE=false

# ---- Scripts only (scripts/create-admin.mjs, scripts/seed-dev.mjs) ----
# SERVER-SIDE SECRET: never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# ---- Edge function secrets (supabase secrets set KEY=value) -----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to edge functions automatically by Supabase.
SITE_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com
# Which customer channels to use: any of email,sms,messenger
NOTIFY_CHANNELS=email,sms,messenger
# Resend (email) — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Nails by An <bookings@your-domain.com>
RESEND_REPLY_TO=
# Twilio (SMS, optional) — set TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+15550001111
TWILIO_MESSAGING_SERVICE_SID=
# Country code used to turn local numbers (0917…) into +63917…
DEFAULT_COUNTRY_CODE=63
# Facebook Messenger Send API (optional, needs a Page access token)
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v21.0
# Owner alerts for new bookings (email and/or SMS)
OWNER_NOTIFY_EMAIL=
OWNER_NOTIFY_PHONE=
# Shared secret the DB trigger sends to send-confirmation (same value as the
# Vault secret notify_webhook_secret — see README §4)
NOTIFY_WEBHOOK_SECRET=
# Only needed if you schedule expire-unpaid-bookings externally
CRON_SECRET=

# ---- Supabase Auth: Login with Facebook (read by supabase/config.toml) --
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
